<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:background="@color/board"
    android:orientation="vertical">

    <!-- Testata gialla: cosa sta succedendo e che ore sono -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/signal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/headerText"
            style="@style/Board.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontVariationSettings="'wght' 800"
            android:text="In partenza"
            android:textColor="@color/board"
            android:textSize="15sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wdth' 75, 'wght' 800"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/board"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/title"
            style="@style/Board.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Board.RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontVariationSettings="'wght' 700"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/progressRow"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Calcoli -->
            <LinearLayout
                android:id="@+id/mathPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/mathProblem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <EditText
                    android:id="@+id/mathAnswer"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/tile_input"
                    android:fontVariationSettings="'wdth' 75, 'wght' 800"
                    android:gravity="center"
                    android:hint="\?"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberSigned"
                    android:textColor="@color/signal"
                    android:textSize="36sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/mathSubmit"
                    style="@style/Board.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conferma" />
            </LinearLayout>

            <!-- Scuoti -->
            <LinearLayout
                android:id="@+id/shakePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/shakeCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/shakeTotal"
                    style="@style/Board.Label.Dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- Codice a barre -->
            <LinearLayout
                android:id="@+id/barcodePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/barcodeLost"
                    style="@style/Board.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non trovo il codice: 8 calcoli al suo posto" />

                <Button
                    android:id="@+id/barcodeScan"
                    style="@style/Board.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scansiona il codice" />
            </LinearLayout>

            <!-- Controllo "sei sveglio?" -->
            <LinearLayout
                android:id="@+id/checkPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/checkCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/Board.Label.Dim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Secondi per confermare" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/checkConfirm"
                    style="@style/Board.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sono sveglio" />
            </LinearLayout>

            <!-- Sopra i pannelli, senza rubare spazio: conta quando c'è la tastiera. -->
            <TextView
                android:id="@+id/statusTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="assertive"
                android:background="@drawable/late_tag"
                android:fontVariationSettings="'wght' 800"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
