<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:background="@color/board"
    android:orientation="vertical">

    <TextView
        style="@style/Board.Label"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:fontVariationSettings="'wght' 800"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:text="@string/settings"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/signal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Board.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/language" />

            <RadioGroup
                android:id="@+id/languageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/langSystem"
                    style="@style/Board.Radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language_system" />

                <RadioButton
                    android:id="@+id/langIt"
                    style="@style/Board.Radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Italiano" />

                <RadioButton
                    android:id="@+id/langEn"
                    style="@style/Board.Radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="English" />
            </RadioGroup>

            <TextView
                style="@style/Board.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/sound" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/tile" />

            <TextView
                android:id="@+id/soundName"
                style="@style/Board.RowText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pickRingtone"
                    style="@style/Board.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pick_ringtone" />

                <Button
                    android:id="@+id/pickFile"
                    style="@style/Board.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/pick_file" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/tile" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Board.RowText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/rampMinutes"
                    android:text="@string/ramp" />

                <EditText
                    android:id="@+id/rampMinutes"
                    style="@style/Board.Count"
                    android:layout_marginStart="12dp"
                    android:importantForAutofill="no"
                    android:maxLength="1" />
            </LinearLayout>

            <TextView
                style="@style/Board.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ramp_hint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/tile" />

            <!-- Firma: porta alla repo su GitHub -->
            <TextView
                android:id="@+id/signature"
                style="@style/Board.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
