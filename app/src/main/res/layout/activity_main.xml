<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:background="@color/board"
    android:orientation="vertical">

    <!-- Testata del tabellone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            style="@style/Board.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontVariationSettings="'wght' 800"
            android:text="@string/board_title"
            android:textSize="15sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabledSwitch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/alarm_on" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/signal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/warningBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/warning_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/warningText"
                    style="@style/Board.RowText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/fixButton"
                    style="@style/Board.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/fix" />
            </LinearLayout>

            <!-- Rullo ore : minuti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <it.sveglia.WheelPicker
                    android:id="@+id/hourWheel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:fontVariationSettings="'wdth' 75, 'wght' 800"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text=":"
                    android:textColor="@color/signal"
                    android:textSize="60sp" />

                <it.sveglia.WheelPicker
                    android:id="@+id/minuteWheel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                style="@style/Board.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/Board.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/days" />

                <TextView
                    style="@style/Board.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/days_none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/daysRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/Board.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/to_stop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/tile" />

            <LinearLayout
                android:id="@+id/mathRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Board.Label"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/plat1" />

                <CheckBox
                    android:id="@+id/mathCheck"
                    style="@style/Board.Mission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/math" />

                <EditText
                    android:id="@+id/mathCount"
                    style="@style/Board.Count"
                    android:contentDescription="@string/math_count"
                    android:maxLength="2" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tile" />

            <LinearLayout
                android:id="@+id/shakeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Board.Label"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/plat2" />

                <CheckBox
                    android:id="@+id/shakeCheck"
                    style="@style/Board.Mission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/shake" />

                <EditText
                    android:id="@+id/shakeCount"
                    style="@style/Board.Count"
                    android:contentDescription="@string/shake_count"
                    android:maxLength="3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tile" />

            <LinearLayout
                android:id="@+id/barcodeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Board.Label"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/plat3" />

                    <CheckBox
                        android:id="@+id/barcodeCheck"
                        style="@style/Board.Mission"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/barcode" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="56dp">

                    <TextView
                        android:id="@+id/barcodeLabel"
                        style="@style/Board.Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/barcodeButton"
                        style="@style/Board.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tile" />

            <LinearLayout
                android:id="@+id/wakeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Board.Label"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/ctrl" />

                <CheckBox
                    android:id="@+id/wakeCheck"
                    style="@style/Board.Mission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wake_check" />

                <EditText
                    android:id="@+id/wakeDelay"
                    style="@style/Board.Count"
                    android:contentDescription="@string/wake_delay"
                    android:maxLength="2" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/tile" />
        </LinearLayout>
    </ScrollView>

    <!-- Comandi fissi in basso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/board"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/testButton"
            style="@style/Board.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test" />

        <Button
            android:id="@+id/saveButton"
            style="@style/Board.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
